
# This config is a STUB! This should never be generated.
# Use the default lua config from https://github.com/hyprwm/Hyprland/blob/main/example/hyprland.lua

autogenerated = 1

$mainMod = SUPER
$terminal = kitty
$fileManager = dolphin
$menu = hyprlauncher

bind = $mainMod, Q, exec, $terminal
# bind = $mainMod, W, exec, zen
bind = $mainMod, C, killactive,
bind = $mainMod, M, exec, command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch exit
bind = $mainMod, E, exec, $fileManager
bind = $mainMod, V, togglefloating,
bind = $mainMod, R, exec, $menu

input {
    kb_layout = latam
    kb_variant =
    kb_model =
    kb_options =
    kb_rule =

    follow_mouse = 1
}



windowrulev2 = float, class:^(zen-pinterest)$
windowrulev2 = size 1400 900, class:^(zen-pinterest)$
windowrulev2 = center, class:^(zen-pinterest)$
windowrulev2 = opacity 0.92 0.92, class:^(zen-pinterest)$
windowrulev2 = rounding 16, class:^(zen-pinterest)$


# Pinterest
windowrulev2 = float, class:^(WebApp-PinterestBrou4396)$
windowrulev2 = size 1400 900, class:^(WebApp-PinterestBrou4396)$
windowrulev2 = center, class:^(WebApp-PinterestBrou4396)$
windowrulev2 = opacity 0.92 0.92, class:^(WebApp-PinterestBrou4396)$
windowrulev2 = rounding 16, class:^(WebApp-PinterestBrou4396)$
bindr = SUPER, SUPER_L, exec, qs -c ~/.config/quickshell ipc call launcher toggle
